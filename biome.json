{
    "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
    "files": {
        "includes": ["src/**", "tests/**", "*.json", "!src/web/static", "!src/user/player.js"]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "a11y": {
                "useMediaCaption": "off",
                "useValidAnchor": "off",
                "useSemanticElements": "off"
            },
            "style": {
                "useConsistentTypeDefinitions": {
                    "level": "error",
                    "options": {
                        "style": "type"
                    }
                },
                "useBlockStatements": "error",
                "noNegationElse": "error"
            },
            "suspicious": {
                "noExplicitAny": "error"
            },
            "complexity": {
                "noForEach": "error"
            },
            "nursery": {
                "noFloatingPromises": "error",
                "noMisusedPromises": "error"
            }
        }
    }
}
