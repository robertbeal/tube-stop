{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": ["src/**", "*.json", "!src/web/static"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useMediaCaption": "off",
        "useValidAnchor": "off",
        "useSemanticElements": "off"
      }
    }
  }
}
